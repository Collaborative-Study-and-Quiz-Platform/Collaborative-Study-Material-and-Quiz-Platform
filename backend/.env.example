# MongoDB connection
MONGODB_URI=REPLACE_WITH_YOUR_MONGODB_CONNECTION_STRING

# JWT configuration
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Set only when the app is behind a trusted reverse proxy, to the exact number of proxy hops
TRUST_PROXY_HOPS=
# For direct HTTPS hosting, configure both certificate file paths instead
HTTPS_KEY_FILE=
HTTPS_CERT_FILE=

# Admin configuration
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Frontend URL
FRONTEND_URL=http://localhost:5173

# SMTP email configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional uptime probe settings (defaults to the local readiness endpoint)
HEALTHCHECK_URL=http://127.0.0.1:5000/api/health/ready
UPTIME_INTERVAL_MS=60000
UPTIME_LOG_FILE=./logs/uptime.jsonl
